# ---- LLM (same variables as Labs 3-4) -------------------------------------
OPENROUTER_API_KEY=<your key>
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL_CHEAP=cohere/north-mini-code:free
OPENROUTER_MODEL_EXPENSIVE=meta-llama/llama-3.1-70b-instruct:free
LOCAL_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_LLM_MODEL_CHEAP=Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
LOCAL_LLM_MODEL_EXPENSIVE=Qwen/Qwen3-4B-GGUF:Q4_K_M

# ---- ListenBrainz ----------------------------------------------------------
LISTENBRAINZ_TOKEN=<from listenbrainz.org -> Settings>   # never commit, log, or store in memory
LISTENBRAINZ_USER=<your ListenBrainz username>
ENCORE_USER_ID=<your ListenBrainz username>               # deletion key for all memory
CONTACT_EMAIL=you@umontana.edu                              # goes in your User-Agent

# ---- Tests (optional) ------------------------------------------------------
# ENCORE_TEST_USER=addiboyer24    # public account the live tests read
# Write round trips are opt-in per run: set ENCORE_WRITE_TESTS=1 on the command line,
# not here, or every test run would write to your account (see README).
